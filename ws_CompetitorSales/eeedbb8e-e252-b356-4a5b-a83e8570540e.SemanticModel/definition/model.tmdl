model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - lh_CompetitorSales"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb"]

ref table Date
ref table Geography
ref table Manufacturer
ref table Product
ref table Sales
ref table _Measures

