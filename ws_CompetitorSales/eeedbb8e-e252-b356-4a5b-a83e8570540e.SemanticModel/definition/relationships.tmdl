relationship fact_sales_ProductID_dim_product_ProductID
	fromColumn: Sales.ProductID
	toColumn: Product.ProductID

relationship dim_product_ManufacturerID_dim_manufacturer_ManufacturerID
	fromColumn: Product.ManufacturerID
	toColumn: Manufacturer.ManufacturerID

relationship fact_sales_Zip_dim_geography_Zip
	fromColumn: Sales.Zip
	toColumn: Geography.Zip

relationship fact_sales_Date_datedimension_Date
	joinOnDateBehavior: datePartOnly
	fromColumn: Sales.Date
	toColumn: Date.Date

