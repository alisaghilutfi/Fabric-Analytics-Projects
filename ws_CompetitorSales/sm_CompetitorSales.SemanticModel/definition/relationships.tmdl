relationship fact_to_dim_product
	fromColumn: fact_sales.ProductID
	toColumn: dim_product.ProductID

relationship dim_product_to_dim_manufacturer
	fromColumn: dim_product.ManufacturerID
	toColumn: dim_manufacturer.ManufacturerID

relationship fact_to_dim_geography
	fromColumn: fact_sales.Zip
	toColumn: dim_geography.Zip

relationship fact_to_dim_date
	joinOnDateBehavior: datePartOnly
	fromColumn: fact_sales.Date
	toColumn: dim_date.Date
