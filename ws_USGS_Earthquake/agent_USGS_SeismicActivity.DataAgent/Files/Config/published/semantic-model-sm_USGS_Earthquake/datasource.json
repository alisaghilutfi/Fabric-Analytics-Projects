    {
      "id": "c770edfd-5fab-40c6-875f-1d26e36e8f17",
      "is_selected": false,
      "display_name": "Earthquake Events",
      "type": "semantic_model.table",
      "description": "One row per seismic event recorded by the USGS. Sourced from the Gold Delta table (earthquake_events_gold) via Direct Lake. Contains location, magnitude, significance, timestamps, country code, and significance classification for each event.",
      "children": [
        {
          "id": "e6305c25-8331-4251-9977-5333e3460605",
          "is_selected": true,
          "display_name": "Title",
          "type": "semantic_model.column",
          "data_type": "String",
          "description": "A short human-readable label for the earthquake event, typically combining the magnitude and location (e.g. 'M 4.5 - 10km NE of City'). Useful for labelling visuals and tooltips.",
          "children": []
        },
        {
          "id": "bcd2bc0d-fad8-4f28-b8ae-ae1b213e3f38",
          "is_selected": true,
          "display_name": "Place Description",
          "type": "semantic_model.column",
          "data_type": "String",
          "description": "A descriptive text of the geographic area nearest to the earthquake epicenter, as reported by the USGS (e.g. '10km NE of Tokyo, Japan'). Provides more detail than the Title alone.",
          "children": []
        },
        {
          "id": "69912c50-73f5-416a-af87-10c44aabbe2a",
          "is_selected": true,
          "display_name": "Magnitude Type",
          "type": "semantic_model.column",
          "data_type": "String",
          "description": "The method or scale used to calculate the Magnitude (e.g. 'ml' for local magnitude, 'mb' for body wave, 'mw' for moment magnitude). Different methods are used depending on the region and the size of the event.",
          "children": []
        },
        {
          "id": "5df55080-f552-4a84-b20e-d80782ae4d83",
          "is_selected": true,
          "display_name": "Event Time",
          "type": "semantic_model.column",
          "data_type": "DateTime",
          "description": "The date and time (UTC) when the earthquake occurred. Use this column for time-based analysis such as trends over days, months, or years.",
          "children": []
        },
        {
          "id": "cd9427a5-7c4d-4d21-8ee0-e9b7c6e8b30d",
          "is_selected": true,
          "display_name": "Country Code",
          "type": "semantic_model.column",
          "data_type": "String",
          "description": "The two-letter ISO country code of the country where the earthquake occurred (e.g. 'US', 'JP', 'TR'). Used for geographic filtering and country-level aggregations.",
          "children": []
        },
        {
          "id": "a918a6f2-8818-430c-a7e1-c3aad54d1065",
          "is_selected": true,
          "display_name": "Significance Class",
          "type": "semantic_model.column",
          "data_type": "String",
          "description": "A categorical classification of the earthquake's significance into three bands: Low, Moderate, or High. Derived from the numeric Significance score to make filtering and visual segmentation easier for report users.",
          "children": []
        }
      ]
    },
