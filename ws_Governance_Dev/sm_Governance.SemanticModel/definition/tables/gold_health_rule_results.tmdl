	column rule_id
		dataType: string
		lineageTag: 376fdcef-ce12-46c4-9c19-bc6e66dd478d
		sourceColumn: rule_id

	column passed
		dataType: boolean
		lineageTag: 91dde9eb-3c01-47c8-a968-e10b7fbf9653
