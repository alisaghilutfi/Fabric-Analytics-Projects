relationship fact_to_dim_customer
	fromColumn: Transactions.customer_id
	toColumn: Customers.customer_id

relationship fact_to_dim_date
	joinOnDateBehavior: datePartOnly
	fromColumn: Transactions.transaction_date
	toColumn: Date.Date

relationship fact_to_dim_channel
	fromColumn: Transactions.channel_key
	toColumn: Channel.channel_key

relationship fact_to_dim_merchant
	fromColumn: Transactions.merchant_key
	toColumn: Merchant.merchant_key

