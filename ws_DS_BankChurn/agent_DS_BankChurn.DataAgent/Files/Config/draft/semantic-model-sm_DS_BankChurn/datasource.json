      "id": "9507a9ba-63a2-443e-9cc1-8cf026fe84b6",
      "is_selected": true,
      "display_name": "_Measures",
      "type": "semantic_model.table",
      "description": "Contains all DAX measures for the BankChurn Data Science project. Measures are organized into display folders covering prediction volume, churn rates, geographic breakdown, and customer risk signals. Data source is the customer_churn_test_predictions Gold table produced by the LightGBM champion model.",
      "children": [
        {
          "id": "f5bba121-cf52-49a4-ba08-581ff926646f",
          "is_selected": true,
          "display_name": "Column",
          "type": "semantic_model.column",
          "data_type": "Int64",
          "description": null,
          "children": []
        },
        {
          "id": "cedcc4c4-a3ff-4266-913b-2eec7db8fedb",
          "is_selected": true,
          "display_name": "Total Customers",
          "type": "semantic_model.measure",
          "data_type": "Int64",
          "description": "Total number of customers scored in the churn prediction test set. Counts every row in the predictions table regardless of filter context.",
          "children": []
        },
        {
          "id": "b07f43d0-0a75-4612-8791-3502f53a3b36",
          "is_selected": true,
          "display_name": "Churned Customers",
          "type": "semantic_model.measure",
          "data_type": "Int64",
          "description": "Number of customers predicted to churn (predictions = 1). Uses CALCULATE with a filter on the predictions column to isolate churned records.",
          "children": []
        },
        {
          "id": "6a747c7a-d23a-4ad8-a4cd-ec42f88ee990",
          "is_selected": true,
          "display_name": "Retained Customers",
          "type": "semantic_model.measure",
          "data_type": "Int64",
          "description": "Number of customers predicted to be retained (predictions = 0). Complements Churned Customers — the two always sum to Total Customers.",
          "children": []
        },
        {
          "id": "6caec84f-98b2-4573-984b-fcd6b367e573",
          "is_selected": true,
          "display_name": "Churn Rate",
          "type": "semantic_model.measure",
          "data_type": "Double",
          "description": "Proportion of customers predicted to churn out of all scored customers. Divides Churned Customers by Total Customers; returns 0 if denominator is empty.",
          "children": []
        },
        {
          "id": "d1ed6006-7222-4f9e-9fbf-6fad1da981b7",
          "is_selected": true,
          "display_name": "Retained Rate",
          "type": "semantic_model.measure",
          "data_type": "Double",
          "description": "Proportion of customers predicted to be retained. Complement of Churn Rate — always equals 1 minus Churn Rate.",
          "children": []
        },
        {
          "id": "3c476866-be3c-4263-8635-5796f7ddf92e",
          "is_selected": true,
          "display_name": "Churn Rate Germany",
          "type": "semantic_model.measure",
          "data_type": "Double",
          "description": "Churn rate among customers from Germany (Geography_Germany = True). Filters the predictions table to German customers before computing the churn ratio.",
          "children": []
        },
        {
          "id": "a518c171-93a0-4a83-a2e1-3510373b6540",
          "is_selected": true,
          "display_name": "Churn Rate Spain",
          "type": "semantic_model.measure",
          "data_type": "Double",
          "description": "Churn rate among customers from Spain (Geography_Spain = True). Filters the predictions table to Spanish customers before computing the churn ratio.",
          "children": []
        },
        {
          "id": "be7f8308-a16c-42db-bc6b-f40b681c33f6",
          "is_selected": true,
          "display_name": "Churn Rate France",
          "type": "semantic_model.measure",
          "data_type": "Double",
          "description": "Churn rate among customers from France (Geography_France = True). Filters the predictions table to French customers before computing the churn ratio.",
          "children": []
        },
        {
          "id": "4ffa4178-9e14-42e8-b2dd-bcfb3597c36d",
          "is_selected": true,
          "display_name": "Avg Credit Score",
          "type": "semantic_model.measure",
          "data_type": "Double",
          "description": "Average credit score across all scored customers in the current filter context. Higher values indicate lower credit risk in the customer segment.",
          "children": []
        },
        {
          "id": "4af44c83-13bd-4ccd-91dc-0b3d416c17be",
          "is_selected": true,
          "display_name": "Avg Balance",
          "type": "semantic_model.measure",
          "data_type": "Double",
          "description": "Average account balance across all scored customers in the current filter context. Useful for comparing financial exposure between churned and retained segments.",
          "children": []
        },
        {
          "id": "33dbbfd7-e04a-4b74-903e-c6280ea7c263",
          "is_selected": true,
          "display_name": "Avg Tenure",
          "type": "semantic_model.measure",
          "data_type": "Double",
          "description": "Average tenure in years across all scored customers in the current filter context. Lower tenure in the churned segment signals early-life churn risk.",
          "children": []
        }
      ]
    },
    {
