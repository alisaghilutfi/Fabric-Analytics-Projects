/// Time-series history from KQL TransformedData silver table. Used for sparkline charts.
table 'Station History'
	lineageTag: 0d508acd-6835-48ad-aeda-8466a4b9f141

	column Timestamp
		dataType: dateTime
		lineageTag: db750013-b5ea-42e5-a6e6-29f8396449a6
		summarizeBy: none
		sourceColumn: Timestamp

	/// Sum of No_Bikes across all 120 stations for this 15-minute bin
	column total_bikes
		dataType: int64
		lineageTag: 524a648f-df50-4ac8-b073-b50820fbb240
		summarizeBy: sum
		sourceColumn: total_bikes

	partition 'Station History' = m
		mode: directQuery
		source =
				let
				    Source = AzureDataExplorer.Contents("https://trd-mpt42n4h5vmke6909h.z2.kusto.fabric.microsoft.com", "eh_RTI_BicycleRentals", "TransformedData | where Timestamp > ago(2h) | summarize total_bikes = sum(No_Bikes) by bin(Timestamp, 15m) | order by Timestamp asc", [MaxRows=null, NoTruncate=null, AdditionalSetStatements=null])
				in
				    Source

