table Fact_Sales
	lineageTag: ffa991bd-2ed6-4aa3-84a2-30a4c915bdad
	sourceLineageTag: [Gold].[Fact_Sales]

	measure Total_Revenue = SUM(Fact_Sales[total_order_value])
		displayFolder: _Measures_Basic
		lineageTag: 19d397f8-bb0d-4aa4-9f08-5f9c21940065

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Orders = DISTINCTCOUNT(Fact_Sales[order_id])
		formatString: 0
		displayFolder: _Measures_Basic
		lineageTag: b8c873f7-4474-4f8a-b16d-7af744aeb4b6

		changedProperty = Name

		changedProperty = DisplayFolder

	measure Average_Order_Value = DIVIDE([Total_Revenue], [Total_Orders], 0)
		displayFolder: _Measures_Basic
		lineageTag: 501ce72f-4fbf-40ec-ab94-1f147775314b

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Revenue_LM = CALCULATE([Total_Revenue], DATEADD(Dim_Date[full_date],-1,MONTH))
		displayFolder: _Measures_TimeIntelligence
		lineageTag: 6dad5ff6-8108-4cce-890f-bd21714bc331

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Revenue_MOM% =
			
			VAR _LM = [Revenue_LM]
			RETURN
			DIVIDE([Total_Revenue]-_LM, _LM, 0)
		displayFolder: _Measures_TimeIntelligence
		lineageTag: 3e0a6f88-58fe-4550-aff5-fc2b892de592

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Active_Customers = DISTINCTCOUNT(Agg_Customer_Intelligence[customer_unique_id])
		formatString: 0
		displayFolder: _Measures_CustomerPerformance
		lineageTag: af1e76bd-4e1f-4a3c-94d5-16f1ff3af198

		changedProperty = Name

		changedProperty = DisplayFolder

	measure Revenue_Per_Customer = DIVIDE([Total_Revenue], [Active_Customers], 0)
		displayFolder: _Measures_CustomerPerformance
		lineageTag: 48985c60-4eb5-4763-bb56-86b81bdc1092

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

